---
/**
 * ApiXref — a cross-reference to another API symbol by fully-qualified id.
 *
 * CONTRACT:
 *   to: string       — a fully-qualified identifier (matches a target's id/anchor)
 *   label?: string   — link text (defaults to `to`)
 *   version?: string — apiVersion of the REFERRING page (optional; emitters may
 *                      pass frontmatter.apiVersion later). Backward compatible:
 *                      when omitted, resolution falls back to the
 *                      version-agnostic map.
 *   origin?: string  — provenance of the reference (e.g. "docstring"), rendered
 *                      as data-xref-origin ONLY when provided. Purely
 *                      informational (analytics / debugging); does not affect
 *                      resolution or the resolved/unresolved classes.
 *
 * Phase C1 resolves the reference at COMPONENT render time (dev + build) via
 * the shared build-time helper `src/lib/xref.ts`, which imports the merged
 * inventory. NOTE: a rehype plugin can NOT rewrite this markup — an Astro
 * component renders AFTER the markdown remark/rehype pipeline — so resolution
 * lives here rather than in `markdown.rehypePlugins`.
 *
 *   resolved   -> href = target url (page path + `#fqName`), class api-xref--resolved
 *   unresolved -> href = `#` + to,                          class api-xref--unresolved
 *
 * The `data-xref-to` attribute and `api-xref` class are preserved so the
 * post-build integration can detect + report unresolved references. Styling
 * lives in the global api.css rather than a scoped <style>, so no
 * `data-astro-cid-*` attribute is added to the <a>.
 */
import { resolveXref } from '@/lib/xref';
import './api.css';

interface Props {
  to: string;
  label?: string;
  version?: string;
  origin?: string;
}
const { to, label, version, origin } = Astro.props;
const resolved = resolveXref(to, version);
const href = resolved ?? '#' + to;
const stateClass = resolved ? 'api-xref--resolved' : 'api-xref--unresolved';
---
<a
  class={`api-xref ${stateClass}`}
  data-xref-to={to}
  data-xref-origin={origin || undefined}
  href={href}
>{label ?? to}</a>
